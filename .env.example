# Environment configuration for EvidenceLens

# Optional LLM API Key (OpenAI) for enhanced dynamic natural language explanations.
# If omitted or left blank, the system automatically uses deterministic evidence-grounded fallback explanations.
OPENAI_API_KEY=

# Optional LLM model choice (e.g. gpt-3.5-turbo, gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional Groq API Key for open-source LLM explanations (e.g. llama-3.1-8b-instant)
GROQ_API_KEY=

# Optional Google Gemini API Key
GEMINI_API_KEY=

# Application settings
APP_ENV=development
LOG_LEVEL=INFO
